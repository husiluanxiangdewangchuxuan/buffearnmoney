{
  "name": "DailyReport",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "scope_note": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "period",
    "generated_at",
    "rows"
  ],
  "rls": {
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "update": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "delete": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    }
  }
}